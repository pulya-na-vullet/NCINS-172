  <bpmn:process id="ump-delete-documents-ncins-pa" name="Удаление документов по заявке" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0b0g240</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="service-task-get-params" name="Получить данные по заявке">
