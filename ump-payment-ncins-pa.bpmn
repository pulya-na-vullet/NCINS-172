  <bpmn:process id="ump-payment-ncins-pa" name="Процесс оплаты" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0wxxwf6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0wxxwf6" sourceRef="StartEvent_1" targetRef="service-task-get-params" />
    <bpmn:serviceTask id="service-task-get-params" name="Получить данные по заявке">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-application-data" />
        <zeebe:ioMapping>
          <zeebe:input source="PAYMENT" target="processType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0wxxwf6</bpmn:incoming>
      <bpmn:outgoing>Flow_1ieni1o</bpmn:outgoing>
