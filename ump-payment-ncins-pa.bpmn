    <bpmn:sequenceFlow id="Flow_1911p8b" sourceRef="receive-message-payment-finished" targetRef="Event_1mq83p5" />
    <bpmn:subProcess id="Activity_0" name="Завершение процесса по таймауту" triggeredByEvent="true">
      <bpmn:startEvent id="timer-start-event-process-timeout">
        <bpmn:outgoing>Flow_0wp5la0</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_1sn8lde">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_16wgp78">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=TIMEOUT" target="timeoutMessage" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0wp5la0</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0wp5la0" sourceRef="timer-start-event-process-timeout" targetRef="Event_16wgp78" />
    </bpmn:subProcess>
  </bpmn:process>
