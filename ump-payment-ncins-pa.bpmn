      <bpmn:outgoing>Flow_1x6xaj2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1x6xaj2" sourceRef="service-task-set-hold" targetRef="service-task-create-payment" />
    <bpmn:serviceTask id="service-task-create-payment" name="Создать платежное поручение">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ump-payment-ncins-pa.create-payment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1x6xaj2</bpmn:incoming>
      <bpmn:outgoing>Flow_0dis5mh</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1mq83p5">
      <bpmn:incoming>Flow_1911p8b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0dis5mh" sourceRef="service-task-create-payment" targetRef="receive-message-payment-finished" />
    <bpmn:receiveTask id="receive-message-payment-finished" name="Получить сообщение о завершении оплаты" messageRef="Message_06u14sl">
      <bpmn:incoming>Flow_0dis5mh</bpmn:incoming>
      <bpmn:outgoing>Flow_1911p8b</bpmn:outgoing>
