    <bpmn:sequenceFlow id="Flow_1ieni1o" sourceRef="service-task-get-params" targetRef="service-task-set-hold" />
    <bpmn:serviceTask id="service-task-set-hold" name="Установить Hold по счету">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ump-payment-ncins-pa.set-hold" />
