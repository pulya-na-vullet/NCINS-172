  <bpmn:process id="ump-signing-documents-ncins-pa" name="Процесс подписания документов" isExecutable="true">
    <bpmn:extensionElements />
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1dd5scg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1dd5scg" sourceRef="StartEvent_1" targetRef="service-task-get-params" />
    <bpmn:endEvent id="Event_0mlzll2">
      <bpmn:incoming>Flow_1f1xt7g</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="service-task-get-params" name="Получить данные по заявке">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="get-application-data" />
        <zeebe:ioMapping>
          <zeebe:input source="SIGNING" target="processType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1dd5scg</bpmn:incoming>
      <bpmn:outgoing>Flow_0swvsiz</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0swvsiz" sourceRef="service-task-get-params" targetRef="Gateway_13ehqon" />
    <bpmn:exclusiveGateway id="Gateway_13ehqon" default="Flow_01m7j1z">
      <bpmn:incoming>Flow_0swvsiz</bpmn:incoming>
      <bpmn:outgoing>Flow_1f1xt7g</bpmn:outgoing>
      <bpmn:outgoing>Flow_01m7j1z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1f1xt7g" sourceRef="Gateway_13ehqon" targetRef="Event_0mlzll2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=systemCode="AlfaOffice"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_16wgp78">
      <bpmn:incoming>Flow_1ekr8uy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01m7j1z" sourceRef="Gateway_13ehqon" targetRef="camunda-connector-transfer-control-signing-docs" />
    <bpmn:serviceTask id="camunda-connector-transfer-control-signing-docs" name="Передать управление. Подписание" zeebe:modelerTemplate="ru.alfabank.ump:process-transfer-camunda-connector:1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ump-process-transfer-connector.transfer-control.v1" />
        <zeebe:ioMapping>
          <zeebe:input source="=true" target="stopInIncident" />
          <zeebe:input source="true" target="useProcessInstanceKey" />
          <zeebe:input source="=systemCode" target="systemCode" />
          <zeebe:input source="SigningDocs" target="messageName" />
          <zeebe:input source="=businessKey" target="applicationId" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" />
          <zeebe:header key="resultExpression" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01m7j1z</bpmn:incoming>
      <bpmn:outgoing>Flow_1udkhwo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1udkhwo" sourceRef="camunda-connector-transfer-control-signing-docs" targetRef="camunda-connector-update-product-stage-sign-waiting" />
    <bpmn:receiveTask id="receive-message-get-control-sign-docs" name="Получить управление. Подписание" messageRef="Message_06u14sl">
      <bpmn:incoming>Flow_0huzqi2</bpmn:incoming>
      <bpmn:outgoing>Flow_0pvla7p</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="Flow_0pvla7p" sourceRef="receive-message-get-control-sign-docs" targetRef="service-task-update-product" />
    <bpmn:serviceTask id="service-task-update-product" name="Обновить данные по продукту">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-product" />
        <zeebe:ioMapping>
          <zeebe:input source="AFTER_SIGNING" target="productUpdateType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0pvla7p</bpmn:incoming>
      <bpmn:outgoing>Flow_1ekr8uy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1ekr8uy" sourceRef="service-task-update-product" targetRef="Event_16wgp78" />
    <bpmn:serviceTask id="camunda-connector-update-product-stage-sign-waiting" name="Обновить стадию продукта" zeebe:modelerTemplate="ru.alfabank.ump:product-stage-camunda-connector:1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ump-product-state-camunda-connector.update-product-stage.v1" />
        <zeebe:ioMapping>
          <zeebe:input source="SIGN_WAITING" target="stageCode" />
          <zeebe:input source="PRODUCT_STAGE_NON_CREDIT_INSURANCE" target="dictionaryCode" />
          <zeebe:input source="=businessKey" target="id" />
          <zeebe:input source="=productCode" target="productCode" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultVariable" />
          <zeebe:header key="resultExpression" value="={stageUpdateResult : resultHeader, stageUpdateMessage : messageHeader}" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1udkhwo</bpmn:incoming>
      <bpmn:outgoing>Flow_0huzqi2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0huzqi2" sourceRef="camunda-connector-update-product-stage-sign-waiting" targetRef="receive-message-get-control-sign-docs" />
    <bpmn:subProcess id="Activity_0" name="Завершение процесса по таймауту" triggeredByEvent="true">
      <bpmn:startEvent id="timer-start-event-process-timeout">
        <bpmn:outgoing>Flow_0n6s4i2</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_1sn8lde">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT25M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:startEvent>
      <bpmn:endEvent id="Event_0d3fc7m">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="=TIMEOUT" target="timeoutMessage" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_0n6s4i2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_0n6s4i2" sourceRef="timer-start-event-process-timeout" targetRef="Event_0d3fc7m" />
    </bpmn:subProcess>
  </bpmn:process>
